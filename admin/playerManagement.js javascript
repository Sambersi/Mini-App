// =====================================================
async function toggleBooleanField(ctx, catKey, fieldKey) {
  const adminId = String(ctx.from.id);
  const session = getSession(adminId);
  if (!session?.targetUserId) return ctx.answerCbQuery('❌ Сначала найдите игрока.');

  const player = getUserById(session.targetUserId);
  if (!player) return ctx.answerCbQuery('❌ Игрок не найден.');

  const cat = CATEGORIES[catKey];
  const fieldCfg = cat?.fields?.[fieldKey];
  if (!fieldCfg || fieldCfg.type !== 'boolean') return ctx.answerCbQuery('❌ Поле не найдено.');

  const oldValue = !!player[fieldKey];
  const newValue = oldValue ? 0 : 1;

  const result = setUserFieldPm(session.targetUserId, fieldKey, newValue);
  if (result.success) {
    await ctx.answerCbQuery(
      `✅ ${fieldCfg.label}: ${boolLabel(oldValue)} → ${boolLabel(!!newValue)}`
    );
    // Обновляем экран категории
    await showEditCategory(ctx, catKey);
  } else {
    await ctx.answerCbQuery(`❌ Ошибка: ${result.message}`);
  }
}

